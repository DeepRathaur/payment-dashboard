# =============================================================================
# Payment Gateway Admin – Environment Variables
# =============================================================================
# Copy to .env.local and set values. Never commit .env or .env.local.
# For Vercel: add these in Project Settings → Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# -----------------------------------------------------------------------------
# Optional (defaults shown)
# -----------------------------------------------------------------------------
# App URL (used for auth callbacks and links). Vercel: set to your deployment URL.
NEXTAUTH_URL="http://localhost:3000"

# Public app URL (client-side). Only needed if different from NEXTAUTH_URL.
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
