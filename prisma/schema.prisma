// Multi-tenant Payment Gateway Admin - Prisma Schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth & Multi-tenancy
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?   // for credentials provider
  role          UserRole  @default(MEMBER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  memberships   OrganizationMember[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Organizations (tenants)
// ---------------------------------------------------------------------------

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     OrganizationMember[]
  apiKeys     ApiKey[]
  customers   Customer[]
  transactions Transaction[]
  settlements Settlement[]
  refunds     Refund[]
  disputes    Dispute[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  role           UserRole @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         String
  organizationId String

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// API keys (per-org, for gateway access)
// ---------------------------------------------------------------------------

model ApiKey {
  id             String   @id @default(cuid())
  name           String
  keyHash        String   // hashed key, never store plaintext
  keyPrefix      String   // e.g. "pk_live_abc" for display only
  lastUsedAt     DateTime?
  createdAt      DateTime @default(now())
  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([keyPrefix])
}

// ---------------------------------------------------------------------------
// Customers (per-org)
// ---------------------------------------------------------------------------

model Customer {
  id             String   @id @default(cuid())
  externalId     String?  // merchant's customer id
  email          String?
  name           String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([organizationId])
  @@index([organizationId, externalId])
}

// ---------------------------------------------------------------------------
// Transactions
// ---------------------------------------------------------------------------

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum TransactionType {
  CHARGE
  REFUND
  PAYOUT
  ADJUSTMENT
}

model Transaction {
  id             String            @id @default(cuid())
  externalId     String?           @unique // gateway id
  amount         Int               // smallest currency unit (e.g. cents)
  currency       String            @db.VarChar(3)
  status         TransactionStatus @default(PENDING)
  type           TransactionType   @default(CHARGE)
  description    String?           @db.Text
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organizationId String
  customerId     String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  refunds      Refund[]
  dispute      Dispute?

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Settlements (payouts to merchant)
// ---------------------------------------------------------------------------

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Settlement {
  id             String          @id @default(cuid())
  externalId     String?         @unique
  amount         Int
  currency       String          @db.VarChar(3)
  status         SettlementStatus @default(PENDING)
  settledAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([settledAt])
}

// ---------------------------------------------------------------------------
// Refunds
// ---------------------------------------------------------------------------

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Refund {
  id             String        @id @default(cuid())
  externalId     String?       @unique
  amount         Int
  currency       String        @db.VarChar(3)
  status         RefundStatus  @default(PENDING)
  reason         String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  transactionId  String
  organizationId String

  transaction  Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([transactionId])
}

// ---------------------------------------------------------------------------
// Disputes (chargebacks)
// ---------------------------------------------------------------------------

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  WON
  LOST
}

model Dispute {
  id             String        @id @default(cuid())
  externalId     String?       @unique
  amount         Int
  currency       String        @db.VarChar(3)
  status         DisputeStatus @default(OPEN)
  reason         String?       @db.Text
  evidence       Json?
  dueBy          DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  transactionId  String        @unique
  organizationId String

  transaction  Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
}
